[sqlfluff]
dialect = sqlite
templater = raw
max_line_length = 80
# AL03 excluded: bound '?' placeholders in INSERT..SELECT need no alias
exclude_rules = ambiguous.column_count, aliasing.expression

[sqlfluff:indentation]
tab_space_size = 2

[sqlfluff:rules:references.keywords]
# `action` is not reserved in SQLite; allow it as the tickets column name
ignore_words = action
